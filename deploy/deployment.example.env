# All values are server-local. Never commit real API keys or database URLs.
DEPLOY_ROOT=/opt/kiro-rs
KIRO_IMAGE=kiro-rs:local
KIRO_NETWORK=deploy_new-api-network
KIRO_CONTAINER_PORT=6091
KIRO_BLUE_PORT=16091
KIRO_GREEN_PORT=16092
KIRO_SITE_PORT=6091
KIRO_PUBLIC_URL=https://example.com:6091
CADDY_ADMIN=http://127.0.0.1:2019
CADDYFILE=/etc/caddy/Caddyfile
KIRO_COMPOSE_FILES=docker-compose.yml,docker-compose.deploy.yml
KIRO_MYSQL_CONTAINER=new-api-mysql
KIRO_MYSQL_DATABASE=kiro_rs
KIRO_VERIFY_API_KEY=replace-with-a-test-user-key
KIRO_VERIFY_MODEL=claude-sonnet-4-5
KIRO_VERIFY_PATH=/cc/v1/messages
KIRO_VERIFY_MODE=required
KIRO_TLS_VERIFY=0
KIRO_BACKUP=1
KIRO_READINESS_SECONDS=90
KIRO_DRAIN_SECONDS=3600
KIRO_STOP_GRACE_SECONDS=3600
KIRO_STATE_DIR=/opt/kiro-rs/deploy-state
